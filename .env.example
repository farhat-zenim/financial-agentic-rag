# Application and data paths
APP_NAME=financial-agentic-rag
DATA_DIR=data/raw_pdfs/pdfs

# Qdrant vector database
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sec_10k_filings

# Retrieval and embedding models
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Local Ollama model
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://127.0.0.1:11434

# Optional local PDF server
PDF_SERVER_URL=http://localhost:8000

# Retrieval and request tuning
CLIENT_TIMEOUT=60
LLM_TIMEOUT=360
DEFAULT_TOP_K=15
DEFAULT_TOP_N=4
MAX_CHUNK_CHARS=1400